    cd examples/embassy/stm32/nucleo-h753zi-ethernet && SCENARIO="{{ scenario }}" cargo run --locked --release --no-default-features --features="{{ features }}" --bin zenoh-app

[working-directory: repository_root]
build-wasm-headless scenario="pub" features="":
    cd examples/wasm && SCENARIO="{{ scenario }}" cargo build --locked --no-default-features --features="{{ features }}" --bin zenoh-app
    wasm-bindgen --target web --out-dir ./examples/wasm/web/ ./target/wasm32-unknown-unknown/debug/zenoh-app.wasm --out-name z_example

[working-directory: repository_root]
wasm-headless scenario="pub" features="":
    just build-wasm-headless "{{ scenario }}" "{{ features }}"
    python3 -m http.server 8000 --bind 127.0.0.1 --directory ./examples/wasm/web

